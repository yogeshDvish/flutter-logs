{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=FlutterLogs;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Logs": {
    "RetentionDays": 30
  },
  "Ingest": {
    "MaxRecordsPerBatch": 500,
    "KeyEnvironment": "live",
    "RotationGraceHours": 24
  },
  "Projects": {
    "MaxPerUser": 20
  },
  "Jwt": {
    "Issuer": "flutter-logs",
    "Audience": "flutter-logs-web",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "EmailVerificationHours": 24,
    "PasswordResetHours": 1,
    "CookieSecure": true,
    "DevEmailMode": false,
    "PublicBaseUrl": "http://localhost:5173",
    "CookieName": "fl_refresh",
    "CookiePath": "/api/v1/auth"
  },
  "RateLimiting": {
    "RegisterPerHour": 5,
    "LoginPerMinute": 10,
    "ForgotPasswordPerHour": 5
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
